\section{Introduction}
The \nqueens\ problem asks to place $N$ queens on an $N \times N$ chessboard
such that no two queens attack each other. This problem serves as a benchmark
for constraint satisfaction and SAT solving techniques.

SAT-based approaches encode the problem as a Boolean satisfiability instance
in Conjunctive Normal Form (\cnf). The efficiency critically depends on the
encoding of cardinality constraints (exactly-one per row/column, at-most-one
per diagonal). This paper evaluates four encoding methods using the PySAT
library.

\section{Methodology}

\subsection{Variable Encoding}
Boolean variable $x_{r,c}$ represents a queen at row $r$, column $c$ (1-indexed).
Total primary variables: $N^2$.

\subsection{Constraints}
\begin{itemize}
    \item Exactly one queen per row: $\sum_c x_{r,c} = 1$ for all $r$
    \item Exactly one queen per column: $\sum_r x_{r,c} = 1$ for all $c$
    \item At most one queen per diagonal ($\searrow$): $\sum_{r-c=d} x_{r,c} \le 1$
    \item At most one queen per anti-diagonal ($\swarrow$): $\sum_{r+c=s} x_{r,c} \le 1$
\end{itemize}

\subsection{Encoding Methods}
\begin{enumerate}
    \item \textbf{Binary (pairwise)}: $\neg x_i \lor \neg x_j$ for all pairs. $O(k^2)$ clauses.
    \item \textbf{Commander (sorting network)}: Hierarchical grouping. $O(k \log k)$ clauses.
    \item \textbf{Product (cardinality network)}: 2D product construction. $O(k \sqrt{k})$ clauses.
    \item \textbf{Sequential counter (Sinz)}: Auxiliary counter variables. $O(k)$ clauses.
\end{enumerate}

\subsection{Solvers Evaluated}
\begin{itemize}
    \item \textbf{CaDiCaL 1.9.5} (cadical195): CDCL with inprocessing
    \item \textbf{Glucose 4.2} (glucose4): Parallel, clause sharing
    \item \textbf{Kissat 2024} (kissat404): Simplified CaDiCaL
    \item \textbf{CryptoMiniSAT 5} (cryptominisat5): XOR handling
    \item \textbf{OR-Tools CP-SAT} (cp-sat): Constraint programming baseline
\end{itemize}

\section{Experimental Setup}
Experiments run on Intel/AMD CPU, 16GB RAM. Time limit: 120 seconds per instance.
Board sizes: $N \in \{8, 10, 12, 14, 16\}$. Sequential execution (multiprocessing
causes segfaults with native SAT solver libraries).

